# Copy this file to ".env" and fill in your own values.
# .env is gitignored - it never gets committed or pushed to GitHub.

# REQUIRED. GGG's API rules require every request (even public/unauthenticated
# ones) to carry a contact email in the User-Agent header. Use your own email.
CONTACT_EMAIL=

# A name for your own app instance, sent in the User-Agent header.
# Any short identifier is fine (no OAuth registration needed for this endpoint).
APP_NAME=poe2-faustus-arb
APP_VERSION=1.0.0

# The exact league name as GGG's API reports it. Case-insensitive substring
# match is used, so "Forbidden Rites" will match "Forbidden Rites" or
# "Forbidden Rites HC" etc. If nothing matches, the tool prints the league
# names it DID see that hour so you can correct this.
LEAGUE_NAME=Forbidden Rites

# poe2 = Path of Exile 2 PC. Other valid values per GGG docs: xbox, sony.
# Leave as poe2 unless you're on a console realm.
REALM=poe2

# The liquidity filter is self-scaling, not a fixed number: each hour, it
# looks at how much every pair actually traded THAT hour and requires a pair
# to be at/above the Nth percentile of that hour's own activity. This way it
# stays correctly strict whether a league is quiet (league start) or booming
# (an active mid-league weekend), instead of a fixed number becoming too
# loose or too strict as trading volume changes.
# MIN_VOLUME_PERCENTILE: 0.0-1.0. 0.90 = only the busiest 10% of pairs count.
MIN_VOLUME_PERCENTILE=0.90
# MIN_VOLUME_ABS_FLOOR: a hard minimum regardless of percentile, so a very
# quiet hour doesn't let near-dead pairs through just because everything
# that hour was quiet.
MIN_VOLUME_ABS_FLOOR=20

# Minimum round-trip profit percent (after using the conservative/worst-case
# rate for every leg) before a cycle is even considered a candidate.
MIN_PROFIT_PCT=2.0

# A candidate cycle must reappear in this many consecutive hourly pulls
# before it is actually alerted (reduces single-hour noise). 2 or 3 recommended.
PERSISTENCE_HOURS=2

# Safety cap on how many distinct negative cycles to extract per run.
MAX_CYCLES_PER_RUN=8

# OPTIONAL - free push notifications to your phone via https://ntfy.sh
# Install the ntfy app, subscribe to a topic name of your choosing (treat it
# like a secret password - anyone who knows it can read your alerts), and
# put that same topic name here. Leave blank to disable.
NTFY_TOPIC=

# OPTIONAL - a Discord webhook URL if you'd rather get alerts in a Discord
# channel. Leave blank to disable.
DISCORD_WEBHOOK_URL=
